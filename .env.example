# Copy to .env.local. Everything is optional; the site works without any of it.

# Canonical URL for metadata/share cards (defaults to https://kharevedant.is-a.dev)
NEXT_PUBLIC_SITE_URL=

# Chat assistant provider (server-only; never prefix with NEXT_PUBLIC_)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional overrides used by tests / proxies
CHAT_TIMEOUT_MS=8000
GROQ_API_BASE=

# Contact form via EmailJS (public browser IDs by design)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# GitHub stats: optional token, read only by /api/github on the server
GITHUB_TOKEN=
GITHUB_API_BASE=
