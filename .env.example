# Public metadata base URL used in app/layout.js
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only API key for the chat route. This is the ONLY recommended name.
GROQ_API_KEY=your_groq_api_key

# Legacy server-side alias, still read if GROQ_API_KEY is unset. Prefer GROQ_API_KEY.
MY_SECRET_API_KEY=

# Optional: model override (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# DEPRECATED - do not set. Still read by the chat route as a last-resort
# fallback so an existing deployment keeps working, but NEXT_PUBLIC_* values are
# baked into build output. Move the key to GROQ_API_KEY and remove this variable.
# NEXT_PUBLIC_GROQ_API_KEY=

# Contact form (EmailJS - public browser SDK keys)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# GitHub stats are fetched unauthenticated from the browser.
# Do NOT add a GitHub token here: any NEXT_PUBLIC_* token is inlined into public JS.
